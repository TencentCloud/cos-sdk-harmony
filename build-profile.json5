{
  "app": {
    "signingConfigs": [
    ],
    "products": [
      {
        "name": "default",
//        "signingConfig": "debug",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "cosTransferPractice",
      "srcPath": "./cosTransferPractice",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "foundation",
      "srcPath": "./foundation"
    },
    {
      "name": "cosSdk",
      "srcPath": "./cosSdk"
    }
  ]
}